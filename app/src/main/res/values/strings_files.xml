    <string name="files_encrypt_change_recipients">Change recipients</string>
    <string name="files_encrypt_forget_passphrase">Forget passphrase</string>
    <string name="files_encrypt_section_sign">Sign (optional)</string>
    <string name="files_encrypt_dont_sign">Don\'t sign</string>
    <string name="files_encrypt_sign_detail">Signs the file with the chosen key, then encrypts. The recipient can verify it came from you; the signer stays hidden inside the ciphertext. Signed files are read twice, so this takes a little longer.</string>
    <string name="files_encrypt_armor">Armor as text</string>
    <string name="files_encrypt_armor_on">Output is text between BEGIN and END markers. Safe to paste anywhere, and about a third larger.</string>
    <string name="files_encrypt_armor_off">Output is raw binary. Smaller, but it won\'t survive being pasted as text.</string>
    <string name="files_encrypt_confirm_picker_first">Confirm or cancel the recipient list above to carry on.</string>
    <string name="files_encrypt_folder_and_encrypt">Choose folder &amp; encrypt</string>
    <string name="files_encrypt_sign_and_encrypt">Sign &amp; encrypt</string>
    <string name="files_encrypt_destination_and_encrypt">Choose destination &amp; encrypt</string>
