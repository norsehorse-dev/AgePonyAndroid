    <string name="files_encrypt_read_failed">Couldn\'t read the files.</string>
    <string name="files_encrypt_oom_passphrase">Not enough memory for the passphrase key derivation on this device. scrypt needs about 256 MB while it runs, whatever the file size, so a smaller file will not help. Encrypting to a recipient key instead needs almost none.</string>
    <string name="files_encrypt_oom">Not enough memory to finish this encrypt. Files are streamed, so this is unusual. Closing other apps and trying again should clear it.</string>

    <!-- Decrypt a file -->
    <string name="files_decrypt_pick_intro">Pick an age file (.age, binary or armored). AgePony tries your identities first, then offers a passphrase if the file needs one. Files are streamed, so size is not a limit.</string>
    <string name="files_decrypt_no_identity">No matching identity in your vault. If this file was encrypted with a passphrase, enter it.</string>
    <string name="files_decrypt_wrong_passphrase">Wrong passphrase, or this file isn\'t passphrase-encrypted.</string>
    <string name="files_decrypt_done">Decrypted</string>
    <string name="files_decrypt_original_name">Original name inside the signed file: %1$s</string>
    <string name="files_decrypt_name_not_covered">Name inside the file (not covered by the signature): %1$s</string>
    <string name="files_decrypt_bundle_failed">This is a bundle of files, but its signature check failed, so AgePony won\'t extract it. Only open the saved file if you trust where it came from.</string>
    <string name="files_decrypt_bundle">This is a bundle of files. You can extract them into a folder.</string>
    <string name="files_decrypt_extracting">Extracting…</string>
    <string name="files_decrypt_extract">Extract files into a folder…</string>
