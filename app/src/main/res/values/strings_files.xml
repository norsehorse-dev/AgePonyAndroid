    </plurals>
    <string name="files_decrypt_signed_by">Signed by %1$s</string>
    <string name="files_decrypt_signed_by_known">Signed by a known key</string>
    <string name="files_decrypt_not_trusted">Valid signature from \"%1$s\", but not trusted. %2$s</string>
    <string name="files_decrypt_not_trusted_default">Valid signature from \"%1$s\", but not trusted. Its entry doesn\'t allow this signature.</string>
    <string name="files_decrypt_valid_unknown">Valid signature (signer not in your vault)</string>
    <string name="files_decrypt_invalid">Signature invalid. %1$s</string>
    <string name="files_decrypt_invalid_default">Signature invalid. It doesn\'t match this file.</string>
    <string name="files_decrypt_unreadable">A signature is attached but can\'t be read, so the signer can\'t be checked.</string>
    <string name="files_decrypt_saved_before_check">%1$s. The file was saved before the signature could be checked: treat its contents as untrusted.</string>
    <string name="files_decrypt_v1_stanza_note">Older signature format (v1): it covers the contents but not who the file was encrypted to.</string>
    <string name="files_decrypt_v1_bundle_note">Older signature format (v1): it covers the contents but not the file name.</string>
    <string name="files_decrypt_oom_passphrase">Not enough memory to derive the key from this passphrase. The file\'s scrypt work factor sets how much is needed, whatever the file size, and this one asks for more than this device has.</string>
    <string name="files_decrypt_oom">Not enough memory to finish this decrypt. Files are streamed, so this is unusual. Closing other apps and trying again should clear it.</string>

    <!-- Inspect a file -->
    <string name="files_inspect_intro">Shows what an age file is encrypted to, without decrypting it. Only the header is read, so this is instant even for very large files, and it reveals nothing that is not already public in the file.</string>
    <string name="files_inspect_summary_armored">%1$s, armored text, %2$d byte header</string>
