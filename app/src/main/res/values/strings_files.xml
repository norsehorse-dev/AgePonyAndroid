    <!-- Encrypt a file -->
    <string name="files_encrypt_pick_intro">Pick one or more files. With several, you choose whether they become one encrypted archive or one encrypted file each. Files are streamed, so size is not a limit.</string>
    <string name="files_encrypt_still_set">Still set from last time: %1$s, %2$s.</string>
    <string name="files_encrypt_output_armored">armored</string>
    <string name="files_encrypt_output_binary">binary</string>
    <string name="files_encrypt_clear_choices">Clear recipients &amp; passphrase</string>
    <plurals name="files_encrypt_file_count">
        <item quantity="one">%1$d file</item>
        <item quantity="other">%1$d files</item>
    </plurals>
    <string name="files_encrypt_mode_question">How should they come out?</string>
    <string name="files_encrypt_mode_bundle">One encrypted archive</string>
    <plurals name="files_encrypt_mode_bundle_detail">
        <item quantity="one">%1$d file goes into a single .tar.age. Decrypting gives back the archive, and any tar tool opens it.</item>
        <item quantity="other">All %1$d files go into a single .tar.age. Decrypting gives back the archive, and any tar tool opens it.</item>
    </plurals>
    <string name="files_encrypt_mode_separate">One encrypted file each</string>
    <plurals name="files_encrypt_mode_separate_detail">
        <item quantity="one">%1$d separate .age file written into a folder you pick. Share or decrypt it independently.</item>
        <item quantity="other">%1$d separate .age files written into a folder you pick. Share or decrypt them independently.</item>
    </plurals>
    <string name="files_encrypt_section_source">Source</string>
    <plurals name="files_encrypt_source_separate">
        <item quantity="one">%1$d file, one .age file each</item>
        <item quantity="other">%1$d files, one .age file each</item>
    </plurals>
    <plurals name="files_encrypt_source_bundle">
        <item quantity="one">%1$d file in one archive</item>
        <item quantity="other">%1$d files in one archive</item>
    </plurals>
