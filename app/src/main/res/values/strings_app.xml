    <!-- Onboarding (the first page reuses app_welcome_title) -->
    <string name="app_onboarding_welcome_body">AgePony encrypts files, text, and notes with the modern age encryption standard. Everything happens right here on your device.</string>
    <string name="app_onboarding_identity_title">Your identity</string>
    <string name="app_onboarding_identity_body">An identity is your personal keypair. The private key is sealed in your vault and never leaves this device. Create one on the Identities tab to start encrypting.</string>
    <string name="app_onboarding_recipients_title">Recipients</string>
    <string name="app_onboarding_recipients_body">Add recipients by their public key or GitHub username. Encrypt to one person or many at once, and to yourself so you can always open your own files.</string>
    <string name="app_onboarding_files_title">Files, text and notes</string>
    <string name="app_onboarding_files_body">Encrypt and decrypt files from the Files tab, encrypt short messages on the Text tab, and keep private notes locked behind your vault.</string>
    <string name="app_onboarding_private_title">No accounts or servers</string>
    <string name="app_onboarding_private_body">AgePony has no accounts, no servers and no tracking. Your vault is sealed on this device and opened only by biometrics, your device PIN or a password. Your keys and your data stay with you.</string>
    <string name="app_onboarding_skip">Skip</string>
    <string name="app_onboarding_next">Next</string>

